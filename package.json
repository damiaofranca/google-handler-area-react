{
    "name": "google-handler-area-react",
    "license": "MIT",
    "description": "Biblioteca para manipulação de áreas no Google Maps em aplicações React.",
    "version": "1.6.1",
    "author": "Damião França",
    "main": "dist/index.umd.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "npm run clean && vite build && tsc",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/damiaofranca/google-handler-area-react.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "keywords": [
        "react",
        "google-maps",
        "handler-area",
        "polygon",
        "create",
        "update",
        "advanced-marker",
        "typescript",
        "maps",
        "area",
        "marker",
        "loader"
    ],
    "dependencies": {
        "@googlemaps/js-api-loader": "1.16.2",
        "@googlemaps/react-wrapper": "1.1.35"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "@googlemaps/markerclusterer": "^2.5.0"
    },
    "devDependencies": {
        "@googlemaps/markerclusterer": "^2.6.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/google.maps": "3.58.1",
        "@types/node": "^20.9.4",
        "@types/react": "^18.0.0",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^2.1.9",
        "jsdom": "^25.0.1",
        "rimraf": "^5.0.5",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vitest": "^2.1.9"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.umd.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=18"
    },
    "peerDependenciesMeta": {
        "react-dom": {
            "optional": true
        },
        "@googlemaps/markerclusterer": {
            "optional": true
        }
    }
}
